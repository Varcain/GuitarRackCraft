<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name="com.varcain.guitarrackcraft.VstHostApplication"
        tools:replace="android:name">

        <!-- VST editor activity. Lives in the MAIN process so it shares the
             in-process X11 server + libvsthost.so state with the audio
             engine that spawned the wine subprocess. (Tried :vstui isolation
             but the X11 server can only run in one process per display, and
             wine was launched by the main process — separating the editor
             causes SIGSEGV on X11 server init.)
             Not exported: only the in-app VST UI launches it, via an explicit
             Intent. Full-flavor only — the playstore flavor doesn't have
             vsthost_lib so this activity wouldn't compile. -->
        <activity
            android:name="com.varcain.guitarrackcraft.ui.vst.VstEditorActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout"
            android:theme="@style/Theme.GuitarRackCraft" />

        <!-- Wine launcher logs (private cache) for `adb shell content
             query/read`, which is how they are read on release builds (no
             run-as). Exported, but guarded by the DUMP permission, which the
             adb shell holds and third-party apps can't obtain. Read-only,
             log names only. See HostLogProvider. -->
        <provider
            android:name="com.varcain.guitarrackcraft.diagnostics.HostLogProvider"
            android:authorities="${applicationId}.hostlogs"
            android:exported="true"
            android:permission="android.permission.DUMP" />

    </application>
</manifest>
